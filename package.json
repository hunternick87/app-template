{
  "name": "create-app-template",
  "version": "1.0.0",
  "description": "Interactive CLI to create modern web applications with Bun, React, TanStack, and Vite",
  "type": "module",
  "bin": {
    "create-app-template": "./cli/index.js"
  },
  "files": [
    "template",
    "cli",
    "generic"
  ],
  "scripts": {
    "dev": "bun --bun run vite",
    "build": "bun --bun run vite build",
    "start": "bun dist/server/server.js"
  },
  "devDependencies": {
    "@types/bun": "latest",
